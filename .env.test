# ====================================================================
# .env.test — תבנית לסביבת test (לא לפרודקשן!)
#
# הוראות:
#   1. cp .env.test .env
#   2. שנו את JWT_SECRET לערך אקראי באורך 32+ תווים
#   3. (אופציונלי) הזינו ANTHROPIC_API_KEY ל-A1/A8/AGENT_CONTEXT מלאים
#   4. docker compose up --build
# ====================================================================

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pension_ops
# פורט host (לא 5432 כדי לא להתנגש עם PG מקומי). בפרודקשן: לא לחשוף.
POSTGRES_PORT=55432

# --- API ---
API_PORT=3000
# JWT_SECRET — חובה. בפיתוח: openssl rand -base64 48
# בפרודקשן זה בא ממנהל סודות (AWS Secrets Manager / Azure Key Vault)
JWT_SECRET=test-only-replace-me-with-32+-random-chars-pls-real-secret
JWT_EXPIRY=12h
DEFAULT_PARSER_VERSION=2024.1

# --- File watcher (קליטה אוטומטית מתיקייה משותפת) ---
# הוסיפו קבצי .xml / .fw לתיקיית inbox (volume) — ייקלטו תוך 5 שניות.
FILE_WATCH_INBOX_DIR=/inbox
FILE_WATCH_ARCHIVE_DIR=/inbox-done
FILE_WATCH_INTERVAL_SEC=5

# --- Bootstrap (סכמה + נתוני דמו) ---
# בכניסה ראשונה ל-test, הפעילו ALL=1 ליצירת נתוני דמו ומשתמשי דמו:
BOOTSTRAP_SEED=1
BOOTSTRAP_DEMO_USERS=1
BOOTSTRAP_WAIT_SEC=60

# --- LLM (אופציונלי) ---
# בלעדיהם המערכת עובדת על fallback דטרמיניסטי (פלט בעברית, ללא embeddings אמיתיים).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Web ---
WEB_PORT=3001
