# חיבור למסד הנתונים
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pension_ops

# נתיב ה-Vault לאחסון קבצים גולמיים (S3 בפרודקשן; תיקייה מקומית בפיתוח)
VAULT_DIR=./vault

# גרסת מבנה אחיד ברירת מחדל אם לא זוהתה מהקובץ
DEFAULT_PARSER_VERSION=2024.1

# שכבת LLM (פרק 11). אם חסר, A1 משתמש ב-fallback דטרמיניסטי.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-7   # ברירת מחדל; אפשר להחליף ל-claude-haiku-4-5 לחיסכון

# Voyage AI עבור embeddings 1536-dim. אם חסר, נופלים ל-hash מקומי דטרמיניסטי.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3
